{
  "name": "@bollfort/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bollfort: shoot down your rivals' walls, then rebuild your own",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.js",
    "start": "node build.js && electron .",
    "package": "node build.js && node package.js"
  },
  "devDependencies": {
    "@bollfort/config": "*",
    "@bollfort/server": "*",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.thomarius.bollfort",
    "productName": "Bollfort",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "package.json",
      "!**/node_modules/@types/**",
      "!**/node_modules/undici-types/**"
    ],
    "extraFiles": [
      {
        "from": "../../THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      }
    ],
    "extraResources": [
      {
        "from": "../../config",
        "to": "config",
        "filter": [
          "*.json"
        ]
      },
      {
        "from": "../client/dist",
        "to": "client"
      },
      {
        "from": "../../assets/store/shortcut_icon.png",
        "to": "assets/store/shortcut_icon.png"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "../../assets/store/shortcut_icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows.${ext}",
      "unpackDirName": "Bollfort",
      "splashImage": "splash.bmp"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "executableName": "bollfort",
      "syncDesktopName": true,
      "icon": "../../assets/store/shortcut_icon.png"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux.${ext}"
    }
  },
  "author": "Thomas Arnold",
  "desktopName": "bollfort.desktop",
  "dependencies": {
    "koffi": "3.3.7",
    "steamworks.js": "0.4.0"
  }
}
